{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "CrmSync": {
    "IntervalMinutes": 120,
    "SendDelaySeconds": 60,
    "BatchSize": 100,
    "LogRetentionDays": 7,
    "LogDirectory": "logs",
    "ApiTimeoutSeconds": 60,
    "ApiBaseUrl": "http://192.168.11.4/carneslandeiro/index.php",
    "AuthorizationPrefix": "Bearer",
    "InstanceLockName": "SigmaCode.Landeiro.CrmSync",
    "CredentialsFile": "C:\\ProgramData\\SigmaCode\\CrmSync\\credenciais.dpapi",
    "Sources": [
      {
        "Name": "CL-CONTA",
        "Order": 1,
        "Entity": "CONTA",
        "AccountType": "CLI",
        "Origins": [ "CL", "CL2" ],
        "View": "u_v_crm_conta_cl",
        "Endpoint": "ImportAccounts",
        "RequestListProperty": "accounts",
        "ResponseListProperty": "accounts",
        "ResponseCodeProperty": "account"
      },
      {
        "Name": "CL-CONTACTO",
        "Order": 2,
        "Entity": "CONTACTO",
        "AccountType": "CLI",
        "Origins": [ "U_CLCONTACT" ],
        "View": "u_v_crm_contacto_cl",
        "Endpoint": "ImportContacts",
        "RequestListProperty": "contacts",
        "ResponseListProperty": "contacts",
        "ResponseCodeProperty": "contact",
        "WaitsForEntity": "CONTA"
      }
    ],
    "FieldLimits": {
      "CONTA": {
        "code": 100, "name": 150, "address": 150, "postalCode": 20, "city": 100, "country": 255,
        "vatNumber": 32, "phone": 100, "mobilePhone": 100, "email": 255, "fax": 100, "accountType": null
      },
      "CONTACTO": {
        "accountCode": 100, "contactCode": 100, "name": 100, "title": 100, "mattersType": 255,
        "phoneOffice": 100, "phoneMobile": 100, "obs": 65000, "email": 255, "department": 255
      }
    }
  }
}
